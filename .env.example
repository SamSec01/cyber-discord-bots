# Copy this file to ".env" and fill in your values.
# .env is in .gitignore, so it never gets pushed to GitHub.
# On GitHub Actions these come from Settings → Secrets and variables → Actions instead.

# --- Discord webhooks (Channel → Edit Channel → Integrations → Webhooks → Copy URL) ---
# To post the same feed to several servers, put several URLs separated by commas.
DISCORD_WEBHOOK_NEWS=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_VULNS=https://discord.com/api/webhooks/xxx/yyy
# Optional: a separate channel just for CISA KEV "actively exploited" alerts.
# Leave blank and they go to the VULNS channel.
DISCORD_WEBHOOK_KEV=
# Optional: a private channel where the bots report errors (broken feed, API down).
DISCORD_WEBHOOK_LOGS=

# --- Optional API keys (both free) ---
# Google AI Studio key → AI-written "why it matters" context on news posts.
# Without it the news bot still adds context using rules (CVEs, tags, summary).
GEMINI_API_KEY=
# NVD API key → raises the NVD rate limit from 5 to 50 requests per 30 seconds.
NVD_API_KEY=
